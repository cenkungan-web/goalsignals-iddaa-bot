[Unit]
Description=Bilyoner Oran Tarayici & Analiz Botu (GoalSignals.com.tr)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/bilyoner_bot
ExecStart=/usr/bin/python3 -m uvicorn app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
